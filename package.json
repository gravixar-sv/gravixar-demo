{
  "name": "gravixar-demo",
  "version": "0.1.0",
  "private": true,
  "description": "demo.gravixar.com, five working scenes with sample data. Vite + React + Tailwind + GSAP, prerendered.",
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "brace-expansion@<1.1.18": "^1.1.18",
      "brace-expansion@>=3.0.0 <5.0.9": "^5.0.9",
      "browserslist@<4.28.7": "^4.28.7",
      "baseline-browser-mapping@<2.11.0": "^2.11.0",
      "@babel/core@<7.29.6": "^7.29.6",
      "esbuild@<0.28.1": "^0.28.1",
      "js-yaml@<4.3.2": "^4.3.2",
      "nanoid@<3.3.17": "^3.3.17",
      "postcss@<8.5.23": "^8.5.23"
    }
  },
  "scripts": {
    "dev": "vite --port 3400 --strictPort",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview --port 3400 --strictPort",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "capture": "node scripts/capture.mjs",
    "verify:learn-beat": "node scripts/verify-learn-beat.mjs",
    "verify:outcomes": "node scripts/verify-outcomes.mjs",
    "capture:scenes": "node scripts/capture-scenes.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/mona-sans": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.184.1",
    "@vercel/config": "^0.7.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "puppeteer-core": "^25.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1"
  },
  "type": "module"
}
